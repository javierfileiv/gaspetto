#!/usr/bin/env bash

# CI unit test script for emu-pc.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
EMU_PC_DIR="$PROJECT_ROOT/soft/emu-pc"
NUM_CORES="$(nproc)"

echo -e "${BLUE}Building and running Gaspetto emu-pc unit tests${NC}"
echo "Project root: $PROJECT_ROOT"
echo "Emu-pc dir  : $EMU_PC_DIR"

cmake --preset tests -S "$EMU_PC_DIR"
cmake --build "$EMU_PC_DIR/build-tests" --parallel "$NUM_CORES" --target utest

echo -e "${YELLOW}Running unit tests...${NC}"
"$EMU_PC_DIR/build-tests/tests/utest" --gtest_color=yes

echo -e "${GREEN}Unit tests passed.${NC}"
